@@ -0,0 +1,11 @@
+#pragma once
+
+namespace direct_launch {
+// Called for every Com_Error; lets a direct launch recover from errors that
+// drop the player out of the match it started.
+void on_com_error(const char *message);
+
+// True for boot zones a direct Zombies launch never uses (multiplayer
+// specialists), so the loader can leave them out.
+bool skip_zone(const char *name);
+} // namespace direct_launch
diff --git a/src/client/component/wmi_startup.cpp b/src/client/component/wmi_startup.cpp
new file mode 100644
index 00000000..949dd28d
--- /dev/null
+++ b/src/client/component/wmi_startup.cpp
@@ -0,0 +1,48 @@
+#include <std_include.hpp>
+
+#include <loader/component_loader.hpp>
+
+#include <utils/hook.hpp>
+
+namespace wmi_startup {
+namespace {
+// One of the game's static initializers connects to the BitLocker WMI
+// namespace before WinMain. For a normal user that connect blocks for about
+// five seconds and the game makes no use of the answer, so the namespace is
+// swapped for one that does not exist, which fails within milliseconds. The
+// rest of the startup (and the root\CIMV2 connect next to it) is untouched.
+constexpr std::wstring_view bitlocker_namespace =
+    L"\\\\.\\root\\CIMV2\\Security\\MicrosoftVolumeEncryption";
+constexpr const wchar_t *missing_namespace =
+    L"\\\\.\\root\\CIMV2\\Security\\boiii_skipped";
+
+utils::hook::detour sys_alloc_string_hook;
+
+BSTR WINAPI sys_alloc_string_stub(const OLECHAR *text) {
+  if (text && bitlocker_namespace == text) {
+    text = missing_namespace;
+  }
+
+  return sys_alloc_string_hook.invoke<BSTR>(text);
+}
+} // namespace
+
+struct component final : generic_component {
+#ifndef NDEBUG
+  std::string name() override { return "wmi_startup"; }
+#endif
+
+  void post_load() override {
+    const utils::nt::library oleaut32 = utils::nt::library::load("oleaut32.dll");
+    if (auto *const sys_alloc_string =
+            oleaut32.get_proc<void *>("SysAllocString")) {
+      sys_alloc_string_hook.create(sys_alloc_string, sys_alloc_string_stub);
+    }
+  }
+
+  // The static initializers have run by now.
+  void post_unpack() override { sys_alloc_string_hook.clear(); }
+};
+} // namespace wmi_startup
+
+REGISTER_COMPONENT(wmi_startup::component)
